{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shayne/RPi-Plane-Radar/raw/main/release/release-manifest.schema.json",
  "title": "RPi Plane Radar release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "source_commit",
    "source_tree",
    "source_timestamp",
    "source_date_epoch",
    "repository",
    "workflow",
    "supported",
    "required_target_packages",
    "minimum_control_version",
    "driver",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "source_commit": {
      "$ref": "#/$defs/commit"
    },
    "source_tree": {
      "$ref": "#/$defs/commit"
    },
    "source_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source_date_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "const": "https://github.com/shayne/RPi-Plane-Radar"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "ref",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "shayne/RPi-Plane-Radar"
        },
        "path": {
          "enum": [
            ".github/workflows/release.yml",
            ".github/workflows/stable-draft.yml"
          ]
        },
        "ref": {
          "type": "string",
          "pattern": "^refs/(heads|tags)/[A-Za-z0-9](?:[A-Za-z0-9._/-]*[A-Za-z0-9])?$"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        }
      }
    },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "display",
        "operating_system",
        "architecture",
        "kernel_policy"
      ],
      "properties": {
        "model": {
          "const": "Raspberry Pi Zero 2 W"
        },
        "display": {
          "const": "HyperPixel 2.1 Round"
        },
        "operating_system": {
          "const": "Raspberry Pi OS Lite Trixie (64-bit)"
        },
        "architecture": {
          "const": "aarch64"
        },
        "kernel_policy": {
          "const": "driver-manifest-supported"
        }
      }
    },
    "required_target_packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]*$"
      }
    },
    "minimum_control_version": {
      "$ref": "#/$defs/version"
    },
    "driver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "version",
        "commit",
        "manifest_sha256",
        "lifecycle_protocol"
      ],
      "properties": {
        "repository": {
          "const": "https://github.com/shayne/hyperpixel2r-kms"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "lifecycle_protocol": {
          "const": "accepted-driver-v2"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 3,
      "required": [
        "planeradar-aarch64-linux-gnu.tar.zst",
        "planeradarctl-aarch64-apple-darwin.tar.zst",
        "planeradarctl-x86_64-apple-darwin.tar.zst"
      ],
      "properties": {
        "planeradar-aarch64-linux-gnu.tar.zst": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "kind": {
                  "const": "application"
                },
                "platform": {
                  "const": "linux-gnu"
                },
                "architecture": {
                  "const": "aarch64"
                },
                "runnable": {
                  "const": true
                }
              }
            }
          ]
        },
        "planeradarctl-aarch64-apple-darwin.tar.zst": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "kind": {
                  "const": "control"
                },
                "platform": {
                  "const": "apple-darwin"
                },
                "architecture": {
                  "const": "aarch64"
                },
                "size": {
                  "maximum": 16777216
                },
                "runnable": {
                  "const": true
                }
              }
            }
          ]
        },
        "planeradarctl-x86_64-apple-darwin.tar.zst": {
          "allOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "properties": {
                "kind": {
                  "const": "control"
                },
                "platform": {
                  "const": "apple-darwin"
                },
                "architecture": {
                  "const": "x86_64"
                },
                "size": {
                  "maximum": 16777216
                },
                "runnable": {
                  "const": true
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:(?:0|[1-9][0-9]*)|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "platform",
        "architecture",
        "size",
        "sha256",
        "runnable"
      ],
      "properties": {
        "kind": {
          "enum": [
            "application",
            "control"
          ]
        },
        "platform": {
          "enum": [
            "linux-gnu",
            "apple-darwin"
          ]
        },
        "architecture": {
          "enum": [
            "aarch64",
            "x86_64"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 134217728
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "runnable": {
          "const": true
        }
      }
    }
  }
}

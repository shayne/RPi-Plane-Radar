FROM rust:1.97.1-trixie@sha256:1bcff4befb740599103a2c7cb51058e14479b2e35e3a34a3f0dc4ede09927488 AS build

RUN rm -f /etc/apt/sources.list /etc/apt/sources.list.d/* \
    && printf '%s\n' \
        'Types: deb' \
        'URIs: https://snapshot.debian.org/archive/debian/20260701T000000Z' \
        'Suites: trixie' \
        'Components: main' \
        'Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg' \
        > /etc/apt/sources.list.d/snapshot.sources \
    && apt-get -o Acquire::Check-Valid-Until=false update \
    && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        file \
        libsdl2-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . .

ARG PLANERADAR_REVISION
ENV PLANERADAR_REVISION=${PLANERADAR_REVISION}

RUN test -f packaging/planeradar.service \
    && cargo build --release --locked --bin planeradar \
    && mkdir -p /out \
    && file target/release/planeradar \
    && readelf -d target/release/planeradar > /out/planeradar.readelf.txt \
    && cp target/release/planeradar /out/planeradar

FROM scratch AS artifact

COPY --from=build /out/planeradar /planeradar
COPY --from=build /out/planeradar.readelf.txt /planeradar.readelf.txt
